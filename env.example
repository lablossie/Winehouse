# Kopieer dit bestand naar .env voor lokaal ontwikkelen (vercel dev leest .env
# automatisch). In productie zet je dezelfde variabelen via Vercel →
# Settings → Environment Variables.

# Toegangscode voor het huishouden. Leeg laten = geen pincode-slot.
APP_PIN=

# Eigen API-sleutel van console.anthropic.com (los tegoed, apart van een
# eventueel Claude.ai/Claude Code-abonnement).
ANTHROPIC_API_KEY=

# Worden automatisch gezet zodra je een Vercel KV- of Upstash Redis-database
# aan het project koppelt via het Vercel-dashboard — hoef je hier niet
# handmatig in te vullen. Beide naamvarianten staan hier alleen ter
# referentie (zie lib/kv.js voor waarom beide worden gecheckt):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
